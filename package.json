{
  "name": "@ai-et-al/symposium",
  "version": "0.9.2",
  "description": "Multi-model deliberation as an MCP server. Convene Claude, GPT, Gemini, Grok, DeepSeek, and Qwen — plus retained seats held by your own subscription CLIs — on one question; surface disagreement verbatim; write every deliberation to a plain-Markdown ledger you own.",
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "llm",
    "council",
    "deliberation",
    "multi-model",
    "dissent",
    "decision-records",
    "ensemble"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-et-al/symposium.git"
  },
  "homepage": "https://github.com/AI-et-al/symposium#readme",
  "bugs": {
    "url": "https://github.com/AI-et-al/symposium/issues"
  },
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "symposium": "dist/server.js"
  },
  "files": [
    "dist",
    "src",
    "spec",
    "docs/janus.md",
    "docs/council-theme.md"
  ],
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/models.json','dist/models.json')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@google/genai": "2.16.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "openai": "7.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
