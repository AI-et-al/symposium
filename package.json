{
  "name": "symposium",
  "version": "0.7.0",
  "description": "Multi-model deliberation as an MCP server. Convene Claude, GPT, Gemini, Grok, and DeepSeek — plus retained seats held by your own subscription CLIs — on one question; surface disagreement verbatim; write every deliberation to a plain-Markdown ledger you own.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "symposium": "dist/server.js"
  },
  "files": [
    "dist",
    "src",
    "spec",
    "docs"
  ],
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp src/models.json dist/models.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@google/genai": "2.16.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "openai": "7.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
